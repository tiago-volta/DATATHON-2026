# LLM Provider Configuration
# Leave empty to use mock responses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider to use: "gemini", "openai", "anthropic", or "mock" (default)
LLM_PROVIDER=mock

# ARASAAC API (no key needed, public API)
ARASAAC_API_URL=https://api.arasaac.org/api

# Auth y base de datos
# Vacío = SQLite en backend/data/inclusivecourt.db
DATABASE_URL=
# Obligatorio en producción (Render). En local hay un valor de desarrollo.
JWT_SECRET=inclusivecourt-dev-secret-cambiar
# Orígenes del front separados por coma (además de localhost)
FRONTEND_ORIGIN=http://localhost:3000
# Cookie Secure (true en HTTPS / producción)
COOKIE_SECURE=false
